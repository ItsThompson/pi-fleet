{
	"name": "@pi-fleet/server",
	"version": "1.2.0",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing.ts"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc --noEmit -p tsconfig.build.json && tsdown",
		"typecheck": "tsc --noEmit",
		"start": "node dist/index.mjs",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@pi-fleet/shared": "*",
		"@fastify/static": "^9.0.0",
		"fastify": "^5.3.3",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^22.15.3",
		"tsdown": "^0.21.0",
		"tsx": "^4.19.4",
		"typescript": "^5.8.3",
		"vitest": "^4.0.18"
	}
}
